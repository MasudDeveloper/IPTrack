# =================================================================
# TrackPulse - Environment Configuration for Custom Hosting & cPanel
# =================================================================

# Node Server Port
PORT=3000

# Base URL for Tracking Links (Replace with your actual domain or subdomain)
# Example: https://yourdomain.com or https://track.yourdomain.com
BASE_URL=https://yourdomain.com

# MySQL / MariaDB Database Credentials (cPanel phpMyAdmin or VPS MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_db_user
DB_PASS=your_cpanel_db_password
DB_NAME=your_cpanel_db_name
